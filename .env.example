# Copia este archivo como .env (no se sube al repo) y completa los valores.
# Lo leen tanto Vite (npm run dev) como docker compose (docker-compose.yml de la raíz).

# ===================== Frontend (npm run dev / npm run build) =====================
# URL base de la API (backend Spring Boot):
#  - Desarrollo: "/api" → el proxy de Vite la redirige a VITE_PROXY_TARGET.
#  - Producción: la URL pública de la EC2 del backend, ej. http://<IP-back>:8080/api
#    (en GitHub Actions se define como variable del repositorio VITE_API_URL).
VITE_API_URL=/api

# Solo desarrollo: a dónde redirige el proxy de Vite las llamadas a /api.
VITE_PROXY_TARGET=http://localhost:8080

# ===================== Todo en local con docker compose up -d --build =====================
# Contraseñas: 8+ caracteres, mayúscula, minúscula, número y símbolo (@#$%!.*). Sin comillas simples.
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Generar con: openssl rand -base64 48
JWT_SECRET=
ADMIN_PASSWORD=
CLIENTE_DEMO_PASSWORD=

# Opcionales (estos son los valores por defecto)
# DB_NAME=huertohogar
# DB_USER=huerto_app
# ADMIN_EMAIL=admin@huertohogar.cl
# CLIENTE_DEMO_EMAIL=cliente@huertohogar.cl
# WEB_PORT=3000         # frontend → http://localhost:3000
# API_PORT=8080         # API      → http://localhost:8080/api
# DB_PORT_LOCAL=3306    # MySQL    → localhost:3306
