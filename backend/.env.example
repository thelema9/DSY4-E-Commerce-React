# Copia este archivo como .env (no se sube al repo) y completa los valores.
# En la EC2 de backend este archivo lo escribe GitHub Actions (workflow backend.yml).

# --- Conexión a MySQL (EC2 de base de datos) ---
# En AWS: IP PRIVADA de la EC2 de base de datos. En local con Docker: host.docker.internal
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=huertohogar
DB_USER=huerto_app
DB_PASSWORD=

# --- JWT ---
# Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# --- CORS: URL pública del frontend (varias separadas por coma) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Usuarios iniciales (los crea la API al arrancar si no existen) ---
# Contraseñas: 8+ caracteres, mayúscula, minúscula, número y símbolo (@#$%!.*)
ADMIN_EMAIL=admin@huertohogar.cl
ADMIN_PASSWORD=
CLIENTE_DEMO_EMAIL=cliente@huertohogar.cl
CLIENTE_DEMO_PASSWORD=

# --- Imagen de la API (en la EC2 la define el workflow; en local se construye con --build) ---
# API_IMAGE=ghcr.io/<usuario>/huertohogar-api:latest
