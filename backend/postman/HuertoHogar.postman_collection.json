{
  "info": {
    "name": "HuertoHogar API",
    "description": "Endpoints principales de la API de HuertoHogar (EP3/EFT).\n\n1. Ajusta las variables de la colección: baseUrl (ej. http://<IP-back>:8080/api o http://localhost:8080/api), adminPassword y clientePassword.\n2. Ejecuta primero 'Auth / Login ADMIN' y 'Auth / Login CLIENTE': guardan los tokens.\n3. Ejecuta el resto en orden (o con el Runner). Cada request verifica su código HTTP esperado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "adminEmail",
      "value": "admin@huertohogar.cl"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "clienteEmail",
      "value": "cliente@huertohogar.cl"
    },
    {
      "key": "clientePassword",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenCliente",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    }
  ],
