# Copia este archivo como .env (no se sube al repo) y completa los valores.
# En la EC2 de base de datos este archivo lo escribe GitHub Actions (workflow database.yml).
# DB_NAME, DB_USER y DB_PASSWORD deben ser los mismos que usa el backend.
DB_NAME=huertohogar
DB_USER=huerto_app
DB_PASSWORD=
DB_ROOT_PASSWORD=
